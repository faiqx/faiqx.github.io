---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  chapter: CollectionEntry<'chapters'>;
  caseStudies: CollectionEntry<'work'>[];
  index: number;
}

const { chapter, caseStudies, index } = Astro.props;
const { Content } = await render(chapter);
const { year, company, companyUrl, location, title, status } = chapter.data;
const bodyId = `chapter-body-${index}`;
const titleId = `chapter-title-${index}`;
---

<article class="chapter" data-chapter>
  <span class="dot" aria-hidden="true"></span>

  <div class="meta">
    <span class="year">{year}</span>
    <span class="where">
      {
        company && (
          <>
            {companyUrl ? (
              <a
                class="company"
                href={companyUrl}
                target="_blank"
                rel="noopener noreferrer"
                set:html={company}
              />
            ) : (
              <span set:html={company} />
            )}
            {' · '}
          </>
        )
      }
      {location}
      {status !== 'published' && <span class="status">{status}</span>}
    </span>
  </div>

  <h3 id={titleId} class="title" data-chapter-title>{title}</h3>

  <div id={bodyId} class="body" data-chapter-body>
    <Content />
    <span class="fade" data-chapter-fade aria-hidden="true"></span>
  </div>

  <div class="actions">
    <button class="toggle" type="button" data-chapter-toggle aria-expanded="false" aria-controls={bodyId}>
      <span data-chapter-label>Read the chapter &darr;</span>
      <span class="sr-only">: {title}</span>
    </button>
    {
      caseStudies.map((entry) => (
        <a class="case-study" href={`/work/${entry.id}/`}>
          {entry.data.linkLabel} &rarr;
        </a>
      ))
    }
  </div>
</article>

<style>
  .chapter {
    position: relative;
    padding: 0 0 clamp(44px, 7vw, 56px) clamp(26px, 5vw, 40px);
  }

  .chapter:last-child {
    padding-bottom: 4px;
  }

  .dot {
    position: absolute;
    left: -5px;
    top: 5px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--ink);
    transform: translateX(-50%);
    /* Background-coloured ring gaps the timeline line behind the dot. */
    box-shadow: 0 0 0 4px var(--bg);
  }

  .meta {
    display: flex;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .year {
    font-family: var(--mono);
    font-size: clamp(18px, 3vw, 22px);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .where {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
  }

  .company {
    border-bottom: 1px solid var(--border);
  }

  /* Dev-only marker for chapters that won't render in production. */
  .status {
    margin-left: 8px;
    border: 1px solid var(--border);
    padding: 2px 7px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10px;
  }

  .title {
    font-size: clamp(19px, 2.6vw, 21px);
    font-weight: 600;
    margin: 0 0 10px;
  }

  .body {
    position: relative;
    overflow: hidden;
    transition: max-height 0.5s ease;
  }

  .body :global(p) {
    font-size: 16px;
    line-height: 1.65;
    color: var(--body);
    margin: 0 0 14px;
    text-wrap: pretty;
  }

  .body :global(p:last-of-type) {
    margin-bottom: 0;
  }

  .fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 60px;
    background: linear-gradient(rgba(245, 245, 244, 0), var(--bg));
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px clamp(16px, 3vw, 24px);
    margin-top: 14px;
  }

  .toggle,
  .case-study {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--secondary);
    border-bottom: 1px solid var(--underline);
  }

  .toggle {
    background: none;
    border-top: none;
    border-left: none;
    border-right: none;
    padding: 0;
    cursor: pointer;
    display: none;
  }

  .case-study {
    color: var(--ink);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  /*
   * Collapsed state is applied only when JavaScript is available, so a no-JS
   * visitor gets the full chapter text rather than a permanently clipped one.
   * The `js` class is set by an inline script before first paint, so there is
   * no flash of expanded content.
   */
  :global(html.js) .title {
    cursor: pointer;
  }

  :global(html.js) .body {
    max-height: 92px;
  }

  :global(html.js) .body.is-open {
    max-height: 2000px;
  }

  :global(html.js) .fade {
    opacity: 1;
  }

  :global(html.js) .body.is-open .fade {
    opacity: 0;
  }

  :global(html.js) .toggle {
    display: inline-block;
  }
</style>
