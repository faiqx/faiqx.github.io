---
import { site } from '../data/site';

// Derived at build time rather than hardcoded, so the notice cannot go stale
// the way four hand-written copies of "2026" would.
const year = new Date().getFullYear();
---

<footer class="rule">
  <span>&copy; {year} {site.name}</span>
  <span class="credit">
    Powered by
    {/* Astro's mark, inlined so the page stays free of third-party requests.
        Single path in currentColor, which keeps it monochrome in both themes.
        Source: simple-icons (CC0). */}
    <a href="https://astro.build" target="_blank" rel="noopener noreferrer" aria-label="Astro">
      <svg viewBox="0 0 24 24" width="13" height="13" role="img" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8.358 20.162c-1.186-1.07-1.532-3.316-1.038-4.944.856 1.026 2.043 1.352 3.272 1.535 1.897.283 3.76.177 5.522-.678.202-.098.388-.229.608-.36.166.473.209.95.151 1.437-.14 1.185-.738 2.1-1.688 2.794-.38.277-.782.525-1.175.787-1.205.804-1.531 1.747-1.078 3.119l.044.148a3.158 3.158 0 0 1-1.407-1.188 3.31 3.31 0 0 1-.544-1.815c-.004-.32-.004-.642-.048-.958-.106-.769-.472-1.113-1.161-1.133-.707-.02-1.267.411-1.415 1.09-.012.053-.028.104-.045.165h.002zm-5.961-4.445s3.24-1.575 6.49-1.575l2.451-7.565c.092-.366.36-.614.662-.614.302 0 .57.248.662.614l2.45 7.565c3.85 0 6.491 1.575 6.491 1.575L16.088.727C15.93.285 15.663 0 15.303 0H8.697c-.36 0-.615.285-.784.727l-5.516 14.99z"
        ></path>
      </svg>
    </a>
  </span>
</footer>

<style>
  footer {
    font-family: var(--mono);
    padding: 28px 0 48px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    font-size: 12px;
    color: var(--muted);
  }

  /* The mark carries the meaning, so no underline here. It sits on the text
     baseline rather than the line box, which is what stops it riding high
     next to the words. */
  .credit {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .credit a {
    display: inline-flex;
    color: var(--secondary);
    transition: color 0.15s ease;
  }

  .credit a:hover {
    color: var(--ink);
  }
</style>
