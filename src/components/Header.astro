---
import { site } from '../data/site';
---

<header>
  <div class="bar">
    <a class="wordmark" href="#top">{site.name}</a>
  </div>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgba(245, 245, 244, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--hairline);
  }

  .bar {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 18px var(--gutter);
    display: flex;
    align-items: center;
  }

  .wordmark {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
  }
</style>
